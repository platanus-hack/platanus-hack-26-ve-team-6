#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state_dir="${GOTCHU_STATE_DIR:-${root}/.gotchu}"
[[ "$state_dir" == /* ]] || state_dir="${root}/${state_dir}"
env_file="${state_dir}/.env"
state_marker="${state_dir}/.gotchu-state"
compose_file="${root}/infra/compose.yaml"
command_name="${1:-up}"; shift || true
slug="$(basename "$root" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')"
suffix="$(printf '%s' "$root" | sha256sum | cut -c1-8)"
project="${GOTCHU_COMPOSE_PROJECT_NAME:-gotchu-${slug}-${suffix}}"
export GOTCHU_STATE_DIR="$state_dir"
compose=(docker compose -p "$project" --env-file "$env_file" -f "$compose_file")

fail() { printf 'Gotchu: %s\n' "$1" >&2; exit "${2:-1}"; }
require_private_env() {
  [[ -f "$env_file" && ! -L "$env_file" ]] || fail 'El archivo de configuración debe ser un archivo regular privado.' 2
  chmod 600 "$env_file"
}
validate_state_location() {
  local root_real state_real
  root_real="$(cd "$root" && pwd -P)"
  state_real="$(cd "$state_dir" && pwd -P)"
  [[ "$state_real" != / ]] || fail 'GOTCHU_STATE_DIR no puede ser la raíz del sistema.' 2
  case "$root_real/" in
    "$state_real/"*) fail 'GOTCHU_STATE_DIR no puede ser el checkout ni uno de sus directorios padre.' 2 ;;
  esac
}
require_managed_state() {
  [[ -d "$state_dir" && ! -L "$state_dir" ]] || fail 'El directorio de estado debe ser real.' 2
  validate_state_location
  [[ -f "$state_marker" && ! -L "$state_marker" ]] || fail 'El directorio no contiene el marcador privado de estado de Gotchu.' 2
  [[ "$(cat "$state_marker")" == 'gotchu-self-host-state-v1' ]] || fail 'El marcador de estado de Gotchu no es válido.' 2
}
env_value() {
  local key="$1" value
  value="$(sed -n "s/^${key}=//p" "$env_file" | head -n1)"
  [[ -n "$value" ]] || fail "Falta ${key} en la configuración privada." 2
  printf '%s' "$value"
}
ensure_state() {
  mkdir -p -- "$state_dir"; [[ -d "$state_dir" && ! -L "$state_dir" ]] || fail 'El directorio de estado debe ser real.' 2
  validate_state_location
  if [[ -e "$state_marker" ]]; then
    require_managed_state
  else
    [[ -z "$(find "$state_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]] || fail 'No se adoptará un directorio de estado preexistente sin el marcador de Gotchu.' 2
    (umask 077; printf '%s\n' 'gotchu-self-host-state-v1' >"$state_marker")
  fi
  mkdir -p -- "$state_dir/github"
  chmod 700 "$state_dir" "$state_dir/github"; chmod 600 "$state_marker"
}
check_docker() {
  command -v docker >/dev/null 2>&1 || fail 'Docker no está instalado. Instala Docker Engine/Desktop y vuelve a ejecutar ./gotchu up.' 2
  docker info >/dev/null 2>&1 || fail 'Docker no está iniciado o tu usuario no tiene acceso. Inicia Docker y vuelve a ejecutar ./gotchu up.' 2
  docker compose version --short >/dev/null 2>&1 || fail 'Se requiere Docker Compose v2 (docker compose). Actualiza Docker o el plugin Compose.' 2
}
check_node() {
  command -v node >/dev/null 2>&1 || fail 'Se requiere Node.js 24 para ejecutar Gotchu en el host.' 2
  node -e 'process.exit(Number(process.versions.node.split(".")[0])===24?0:1)' || fail 'Gotchu requiere Node.js 24.' 2
}
check_pnpm() {
  command -v pnpm >/dev/null 2>&1 || fail 'Se requiere pnpm 11 y Node.js 24 para instalar y preparar Gotchu.' 2
  [[ "$(pnpm --version)" == 11.* ]] || fail 'Gotchu requiere pnpm 11. Instala la versión indicada en package.json.' 2
}
check_host_identity() {
  local uid gid
  uid="$(id -u)"; gid="$(id -g)"
  [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ && "$uid" != 0 && "$gid" != 0 ]] || fail 'Ejecuta Gotchu como usuario Linux sin privilegios y con acceso al daemon Docker; no uses sudo.' 2
}
ensure_free_ports() {
  node - "$@" <<'NODE'
const net = require('node:net');
const ports = process.argv.slice(2).map(Number);
const labels = ['GOTCHU_WEB_PORT', 'GOTCHU_COORDINATOR_PORT', 'GOTCHU_SCANNER_PORT', 'GOTCHU_POSTGRES_PORT', 'GOTCHU_REDIS_PORT'];
let index = 0;
function next() {
  if (index === ports.length) return process.exit(0);
  const port = ports[index]; const label = labels[index++]; const server = net.createServer();
  server.once('error', () => { console.error(`Gotchu: el puerto ${port} está ocupado. Cambia ${label} en tu entorno y vuelve a ejecutar.`); process.exit(1); });
  server.listen(port, '127.0.0.1', () => server.close(next));
}
next();
NODE
}
read_setup_environment() {
  if [[ -e "$env_file" ]]; then
    [[ -f "$env_file" && ! -L "$env_file" ]] || fail 'El archivo de configuración debe ser un archivo regular privado.' 2
    chmod 600 "$env_file"
    return
  fi
  local web_port="${GOTCHU_WEB_PORT:-3000}" coordinator_port="${GOTCHU_COORDINATOR_PORT:-3003}" scanner_port="${GOTCHU_SCANNER_PORT:-4400}" postgres_port="${GOTCHU_POSTGRES_PORT:-55432}" redis_port="${GOTCHU_REDIS_PORT:-56379}"
  for port in "$web_port" "$coordinator_port" "$scanner_port" "$postgres_port" "$redis_port"; do [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1024 && port <= 65535 )) || fail 'Los puertos configurados deben estar entre 1024 y 65535.' 2; done
  ensure_free_ports "$web_port" "$coordinator_port" "$scanner_port" "$postgres_port" "$redis_port"
  ensure_state
  GOTCHU_ENV_FILE="$env_file" GOTCHU_AUTH_MODE=self_host GOTCHU_CUSTOMER_DISCOVERY=true GOTCHU_WEB_PORT="$web_port" GOTCHU_COORDINATOR_PORT="$coordinator_port" GOTCHU_SCANNER_PORT="$scanner_port" GOTCHU_POSTGRES_PORT="$postgres_port" GOTCHU_REDIS_PORT="$redis_port" GOTCHU_PUBLIC_URL="${GOTCHU_PUBLIC_URL:-http://localhost:${web_port}}" bash "$root/scripts/infra-local-setup.sh" >/dev/null
}
ensure_scanner_secret() {
  local path="$state_dir/scanner.secret"
  [[ -e "$path" ]] || (umask 077; openssl rand 32 >"$path")
  [[ -f "$path" && ! -L "$path" && "$(wc -c <"$path")" -eq 32 ]] || fail 'El secreto del scanner debe ser un archivo regular de 32 bytes.' 2
  chmod 600 "$path"
}
ensure_scanner_tls() {
  local cert="$state_dir/scanner.crt" key="$state_dir/scanner.key" cert_public key_public tmp_cert="${state_dir}/.scanner.crt.$$" tmp_key="${state_dir}/.scanner.key.$$" san='DNS:localhost,IP:127.0.0.1'
  if [[ -f "$cert" && ! -L "$cert" && -f "$key" && ! -L "$key" ]] \
    && openssl x509 -in "$cert" -noout -checkhost localhost 2>/dev/null | grep -Fq 'Hostname localhost does match certificate' \
    && openssl x509 -in "$cert" -noout -checkend 86400 >/dev/null 2>&1 \
    && openssl x509 -in "$cert" -noout -ext basicConstraints 2>/dev/null | grep -q 'CA:TRUE'; then
    local valid_ips=true
    openssl x509 -in "$cert" -noout -checkip 127.0.0.1 2>/dev/null | grep -Fq 'IP 127.0.0.1 does match certificate' || valid_ips=false
    if [[ "$valid_ips" == true ]]; then
      cert_public="$(openssl x509 -in "$cert" -pubkey -noout | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | cut -d' ' -f1)"
      key_public="$(openssl pkey -in "$key" -pubout -outform DER 2>/dev/null | sha256sum | cut -d' ' -f1)"
      if [[ -n "$cert_public" && "$cert_public" == "$key_public" ]]; then chmod 600 "$cert" "$key"; return; fi
    fi
  fi
  (umask 077; openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 3650 \
    -keyout "$tmp_key" -out "$tmp_cert" -subj '/CN=localhost' \
    -addext 'basicConstraints=critical,CA:TRUE' \
    -addext 'keyUsage=critical,digitalSignature,keyEncipherment,keyCertSign,cRLSign' \
    -addext 'extendedKeyUsage=serverAuth' \
    -addext "subjectAltName=${san}") >/dev/null 2>&1 || fail 'No se pudo crear el certificado TLS privado del scanner.'
  chmod 600 "$tmp_cert" "$tmp_key"
  mv -f -- "$tmp_cert" "$cert"; mv -f -- "$tmp_key" "$key"
}
compose_ready() {
  local user db redis_password; user="$(env_value POSTGRES_USER)"; db="$(env_value POSTGRES_DB)"; redis_password="$(env_value REDIS_PASSWORD)"
  for _ in $(seq 1 90); do
    if "${compose[@]}" exec -T postgres pg_isready -h 127.0.0.1 -U "$user" -d "$db" >/dev/null 2>&1 && "${compose[@]}" exec -T -e "REDISCLI_AUTH=${redis_password}" redis redis-cli ping 2>/dev/null | grep -qx PONG; then return; fi
    sleep 1
  done
  fail 'Postgres o Redis no alcanzaron estado saludable. Ejecuta ./gotchu logs postgres y ./gotchu doctor.'
}
app_entry() {
  case "$1" in
    web) printf '%s' "$root/apps/web/.output/server/index.mjs" ;;
    coordinator) printf '%s' "$root/apps/coordinator/dist/main.js" ;;
    scanner) printf '%s' "$root/apps/scanner/dist/main.js" ;;
    *) return 1 ;;
  esac
}
app_pid() { [[ -f "$state_dir/$1.pid" && ! -L "$state_dir/$1.pid" ]] && cat "$state_dir/$1.pid" || true; }
app_process_matches() {
  local service="$1" pid args entry cwd
  pid="$(app_pid "$service")"; [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  args="$(ps -p "$pid" -o args= 2>/dev/null || true)"; entry="$(app_entry "$service")"
  [[ "$args" == *"$entry"* && "$args" == *"$root"* && "$args" == *"--gotchu-instance=$project"* ]] || return 1
  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  [[ "$cwd" == "$root" ]]
}
app_running() {
  local service="$1" pid args
  app_process_matches "$service" || return 1
  pid="$(app_pid "$service")"; args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  [[ "$args" == *"gotchu-instance=$project"* ]]
}
optional_env_value() { sed -n "s/^$1=//p" "$env_file" | head -n1; }
postgres_url() {
  node - "$1" "$2" "$3" "$4" <<'NODE'
const [user, password, port, database] = process.argv.slice(2);
process.stdout.write(`postgresql://${encodeURIComponent(user)}:${encodeURIComponent(password)}@127.0.0.1:${port}/${encodeURIComponent(database)}`);
NODE
}
redis_url() {
  node - "$1" "$2" <<'NODE'
const [password, port] = process.argv.slice(2);
process.stdout.write(`redis://:${encodeURIComponent(password)}@127.0.0.1:${port}`);
NODE
}
start_app() {
  local service="$1" port="$2" pidfile="$state_dir/$1.pid" logfile="$state_dir/$1.log" entry
  entry="$(app_entry "$service")"
  if app_running "$service"; then return 0; fi
  if app_process_matches "$service"; then stop_app "$service"; fi
  [[ -e "$pidfile" ]] && rm -f -- "$pidfile"
  (umask 077; touch "$logfile"); chmod 600 "$logfile"
  local -a environment=("NODE_ENV=production")
  case "$service" in
    scanner)
      environment+=("GOTCHU_SCANNER_SECRET_FILE=$state_dir/scanner.secret" "GOTCHU_SCANNER_PORT=$port" "GOTCHU_SCANNER_HOST=127.0.0.1" \
        "GOTCHU_SCANNER_TLS_CERT_FILE=$state_dir/scanner.crt" "GOTCHU_SCANNER_TLS_KEY_FILE=$state_dir/scanner.key" \
        "GOTCHU_SCANNER_TRIVY_DB_DIRECTORY=$root/.local/dev/trivy-db" "GOTCHU_SCANNER_OSV=1")
      ;;
    coordinator)
      local database_url redis_connection_url
      database_url="$(postgres_url "$(env_value GOTCHU_COORDINATOR_DB_USERNAME)" "$(env_value GOTCHU_COORDINATOR_DB_PASSWORD)" "$(env_value POSTGRES_HOST_PORT)" "$(env_value POSTGRES_DB)")"
      redis_connection_url="$(redis_url "$(env_value REDIS_PASSWORD)" "$(env_value REDIS_HOST_PORT)")"
      environment+=("PORT=$port" "GOTCHU_COORDINATOR_HOST=127.0.0.1" "GOTCHU_CUSTOMER_DISCOVERY=true" "GOTCHU_ORGANIZATION_IDS=" \
        "GOTCHU_COORDINATOR_DATABASE_URL=$database_url" "GOTCHU_REDIS_URL=$redis_connection_url" "GOTCHU_SCANNER_ORIGIN=https://127.0.0.1:$(env_value SCANNER_HOST_PORT)" \
        "GOTCHU_SCANNER_SECRET_FILE=$state_dir/scanner.secret" "GOTCHU_SCANNER_CA_FILE=$state_dir/scanner.crt")
      ;;
    web)
      local api_url ingest_url github_app_file github_credentials_file webauthn_rp_id
      api_url="$(postgres_url "$(env_value GOTCHU_API_DB_USERNAME)" "$(env_value GOTCHU_API_DB_PASSWORD)" "$(env_value POSTGRES_HOST_PORT)" "$(env_value POSTGRES_DB)")"
      ingest_url="$(postgres_url "$(env_value GOTCHU_INGEST_DB_USERNAME)" "$(env_value GOTCHU_INGEST_DB_PASSWORD)" "$(env_value POSTGRES_HOST_PORT)" "$(env_value POSTGRES_DB)")"
      github_app_file="$(optional_env_value GOTCHU_GITHUB_READER_APP_FILE)"
      webauthn_rp_id="$(optional_env_value GOTCHU_WEBAUTHN_RP_ID)"
      if [[ "$github_app_file" == /run/secrets/github/* ]]; then github_app_file="$state_dir/github/${github_app_file##*/}"; fi
      github_credentials_file="$(optional_env_value GOTCHU_GITHUB_READER_APP_CREDENTIALS_FILE)"
      if [[ "$github_credentials_file" == /run/secrets/github/* ]]; then github_credentials_file="$state_dir/github/${github_credentials_file##*/}"; fi
      environment+=("PORT=$port" "NITRO_PORT=$port" "HOST=127.0.0.1" "NITRO_HOST=127.0.0.1" "PUBLIC_APP_URL=$(env_value PUBLIC_APP_URL)" \
        "AUTH_SECRET=$(env_value AUTH_SECRET)" "GOTCHU_AUTH_MODE=self_host" "GOTCHU_API_DATABASE_URL=$api_url" "GOTCHU_INGEST_DATABASE_URL=$ingest_url" \
        "AUTH_GITHUB_ID=$(optional_env_value AUTH_GITHUB_ID)" "AUTH_GITHUB_SECRET=$(optional_env_value AUTH_GITHUB_SECRET)" \
        "AUTH_GOOGLE_ID=$(optional_env_value AUTH_GOOGLE_ID)" "AUTH_GOOGLE_SECRET=$(optional_env_value AUTH_GOOGLE_SECRET)" \
        "AUTH_OIDC_ISSUER=$(optional_env_value AUTH_OIDC_ISSUER)" "AUTH_OIDC_CLIENT_ID=$(optional_env_value AUTH_OIDC_CLIENT_ID)" \
        "AUTH_OIDC_CLIENT_SECRET=$(optional_env_value AUTH_OIDC_CLIENT_SECRET)" "AUTH_OIDC_NAME=$(optional_env_value AUTH_OIDC_NAME)" \
        "GOTCHU_GITHUB_READER_APP_FILE=$github_app_file" "GOTCHU_GITHUB_APP_SLUG=$(optional_env_value GOTCHU_GITHUB_APP_SLUG)" \
        "GOTCHU_GITHUB_READER_APP_CREDENTIALS_FILE=$github_credentials_file" \
        "GOTCHU_GITHUB_READER_INSTALLATION_ID=$(optional_env_value GOTCHU_GITHUB_READER_INSTALLATION_ID)" \
        "GOTCHU_EVENT_SIGNING_KEYS_JSON=$(optional_env_value GOTCHU_EVENT_SIGNING_KEYS_JSON)" \
        "GOTCHU_DNS_SERVERS_JSON=$(optional_env_value GOTCHU_DNS_SERVERS_JSON)" \
        "GOTCHU_EVENT_CREDENTIAL_DIRECTORY=$state_dir/event-credentials")
      [[ -z "$webauthn_rp_id" ]] || environment+=("GOTCHU_WEBAUTHN_RP_ID=$webauthn_rp_id")
      ;;
  esac
  node -e 'process.exit(Number(process.versions.node.split(".")[0])===24?0:1)' || fail 'Gotchu requiere Node.js 24.' 2
  setsid env -i "PATH=${PATH:-/usr/local/bin:/usr/bin:/bin}" "HOME=$state_dir" "LANG=${LANG:-C.UTF-8}" "${environment[@]}" \
    nohup node "$entry" "--gotchu-instance=$project" >>"$logfile" 2>&1 </dev/null &
  printf '%s\n' "$!" >"$pidfile"; chmod 600 "$pidfile"
  for _ in $(seq 1 20); do app_running "$service" && return 0; kill -0 "$(app_pid "$service")" 2>/dev/null || break; sleep .1; done
  fail "No se pudo iniciar ${service}. Revisa ./gotchu logs ${service}."
}
stop_app() {
  local service="$1" pid
  pid="$(app_pid "$service")"
  if app_process_matches "$service"; then
    kill -TERM "$pid"
    for _ in $(seq 1 40); do app_process_matches "$service" || break; sleep .25; done
    app_process_matches "$service" && fail "${service} no terminó tras SIGTERM; conserva su PID en ${state_dir}/${service}.pid para revisarlo."
  fi
  rm -f -- "$state_dir/$service.pid"
}
wait_http() {
  node - "$1" "$2" <<'NODE'
const [url, name] = process.argv.slice(2); const deadline = Date.now() + 180000; const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
for (;;) { try { const response = await fetch(url, {signal: AbortSignal.timeout(5000)}); const body = await response.json(); if (response.ok && (body.ready === true || body.status === 'ready')) break; } catch {}
  if (Date.now() >= deadline) { console.error(`Gotchu: ${name} no quedó listo en 180 segundos. Revisa ./gotchu logs ${name}.`); process.exit(1); } await delay(1000); }
NODE
}
setup_link() {
  [[ -f "$env_file" ]] || fail 'Ejecuta ./gotchu up antes de pedir un enlace de configuración.' 2
  require_managed_state; require_private_env; check_docker
  local token hash user db result url; token="$(openssl rand -hex 32)"; hash="$(printf '%s' "$token" | sha256sum | cut -d' ' -f1)"
  user="$(env_value POSTGRES_USER)"; db="$(env_value POSTGRES_DB)"
  result="$(printf '%s\n' "SELECT gotchu.self_host_issue_setup_token(:'token_hash', now() + interval '1 hour');" | "${compose[@]}" exec -T postgres psql -U "$user" -d "$db" -v token_hash="$hash" -Atq 2>/dev/null)" || fail 'No se pudo emitir el enlace. Ejecuta ./gotchu up y revisa ./gotchu logs postgres.'
  if [[ "$result" == f ]]; then
    local owner_exists
    owner_exists="$("${compose[@]}" exec -T postgres psql -U "$user" -d "$db" -Atq -c 'SELECT EXISTS (SELECT 1 FROM gotchu.self_host_bootstrap_state WHERE singleton)' 2>/dev/null)" || fail 'No se pudo comprobar el Owner inicial. Revisa ./gotchu logs postgres.'
    [[ "$owner_exists" == t ]] && { printf '%s\n' 'El workspace ya tiene un Owner; no se emitió otro enlace.'; return 0; }
    fail 'No se emitió el enlace. Ejecuta ./gotchu up y revisa ./gotchu logs postgres.'
  fi
  [[ "$result" == t ]] || fail 'La base de datos devolvió una respuesta inesperada al emitir el enlace.'
  url="$(env_value PUBLIC_APP_URL)"; printf 'Enlace de configuración (un uso, caduca en 1 h): %s/setup?token=%s\n' "$url" "$token"
}
scanner_probe() {
  local probe_source
  probe_source="$(cat "$root/scripts/infra-scanner-probe.mjs")" || return 1
  GOTCHU_SCANNER_PROBE_INLINE=1 GOTCHU_SCANNER_ORIGIN="https://127.0.0.1:$(env_value SCANNER_HOST_PORT)" GOTCHU_SCANNER_CA_FILE="$state_dir/scanner.crt" node --input-type=module -e "$probe_source"
}
up() {
  local started rebuild=false; started="$(date +%s)"
  if [[ "${1:-}" == true ]]; then rebuild=true; fi
  ensure_state; check_docker; check_node; check_host_identity; read_setup_environment; ensure_scanner_secret; check_pnpm
  [[ -d "$root/node_modules" ]] || pnpm install --frozen-lockfile --ignore-scripts
  INFRA_ENV_FILE="$env_file" GOTCHU_STATE_DIR="$state_dir" bash "$root/scripts/infra-compose-validate.sh"
  if [[ "$rebuild" == true ]] || [[ ! -f "$root/apps/web/.output/server/index.mjs" ]] || [[ ! -f "$root/apps/coordinator/dist/main.js" ]] || [[ ! -f "$root/apps/scanner/dist/main.js" ]]; then
    rebuild=true
    GOTCHU_ENV_FILE="$env_file" GOTCHU_AUTH_MODE=self_host pnpm dev:prepare
    pnpm build
  else
    printf '%s\n' 'Usando los servicios ya preparados. Ejecuta ./gotchu upgrade para reconstruirlos.'
  fi
  "${compose[@]}" up -d postgres redis; compose_ready
  INFRA_ENV_FILE="$env_file" INFRA_PROJECT_NAME="$project" bash "$root/scripts/infra-db-bootstrap.sh"
  ensure_scanner_tls
  stop_app web; stop_app coordinator; stop_app scanner
  local scanner_port coordinator_port web_port; scanner_port="$(env_value SCANNER_HOST_PORT)"; coordinator_port="$(env_value COORDINATOR_HOST_PORT)"; web_port="$(env_value WEB_HOST_PORT)"
  start_app scanner "$scanner_port"
  NODE_EXTRA_CA_CERTS="$state_dir/scanner.crt" wait_http "https://127.0.0.1:${scanner_port}/readyz" scanner
  start_app coordinator "$coordinator_port"
  wait_http "http://127.0.0.1:${coordinator_port}/health/ready" coordinator
  local probe_output
  if ! probe_output="$(scanner_probe 2>&1)"; then fail "El coordinator no puede alcanzar el scanner por HTTPS en loopback (${probe_output:-sin diagnóstico}). Revisa ./gotchu logs coordinator y ./gotchu logs scanner."; fi
  [[ "$probe_output" == scanner_ready ]] || fail 'El coordinator no confirmó la disponibilidad del scanner.'
  start_app web "$web_port"
  wait_http "$(env_value PUBLIC_APP_URL)/api/ready" web
  printf 'Gotchu listo en %s (%ss desde ./gotchu up).\n' "$(env_value PUBLIC_APP_URL)" "$(($(date +%s)-started))"
  printf '%s\n' 'Semgrep 1.182.0 está fijado por digest; la cobertura es parcial y no demuestra que la aplicación sea segura.'
  setup_link
}
status() {
  [[ -f "$env_file" ]] || fail 'Gotchu no está configurado. Ejecuta ./gotchu up.' 2; require_managed_state; require_private_env; check_docker; "${compose[@]}" ps
  for service in web coordinator scanner; do
    if app_running "$service"; then printf '%s: ejecutándose en loopback\n' "$service"; else printf '%s: detenido\n' "$service"; fi
  done
  if app_running scanner && app_running coordinator; then
    local probe_output probe_code
    if probe_output="$(scanner_probe 2>&1)"; then printf '%s\n' 'coordinator → scanner: accesible (HTTPS + perfiles de escaneo listos)'; else
      probe_code="${probe_output##*:}"; [[ "$probe_code" =~ ^[A-Za-z_]+$ ]] || probe_code='no_disponible'
      printf 'coordinator → scanner: inaccesible (%s)\n' "$probe_code"
    fi
  fi
  printf '%s\n' 'validator: no disponible; requiere Linux, /dev/kvm, bwrap y sesión systemd de usuario.'
  if [[ -f "$state_dir/github/reader-app.json" ]]; then printf '%s\n' 'GitHub Reader App: archivo de credenciales presente; permisos de escritura no están configurados.'; else printf '%s\n' 'GitHub Reader App: no configurada; ejecuta ./gotchu github setup.'; fi
  printf '%s\n' 'executor y escrituras a proveedores: no disponibles.'
}
logs() {
  local service="${1:-}"
  if [[ "$service" =~ ^(web|coordinator|scanner)$ ]]; then [[ -f "$state_dir/$service.log" ]] && tail -n 200 -f "$state_dir/$service.log" || fail "No hay registro de ${service}." 2; return; fi
  [[ -z "$service" || "$service" =~ ^(postgres|redis)$ ]] || fail 'Servicio inválido. Usa web, coordinator, scanner, postgres o redis.' 2
  if [[ -n "$service" ]]; then "${compose[@]}" logs --tail 200 -f "$service"; else tail -n 200 -f "$state_dir/web.log" "$state_dir/coordinator.log" "$state_dir/scanner.log"; fi
}
read_backup_passphrase() {
  [[ -t 0 ]] || fail 'La frase de paso se solicita de forma interactiva para no exponerla en argumentos o variables de entorno.' 2
  local first second byte_count
  printf 'Frase de paso (mínimo 16 bytes): ' >&2
  IFS= read -r -s first || fail 'No se pudo leer la frase de paso.' 2
  printf '\n' >&2
  byte_count="$(printf '%s' "$first" | wc -c | tr -d '[:space:]')"
  (( byte_count >= 16 && byte_count <= 1024 )) || fail 'La frase de paso debe tener entre 16 y 1024 bytes.' 2
  if [[ "${1:-}" == confirm ]]; then
    printf 'Repite la frase de paso: ' >&2
    IFS= read -r -s second || fail 'No se pudo leer la confirmación de la frase de paso.' 2
    printf '\n' >&2
    [[ "$first" == "$second" ]] || fail 'Las frases de paso no coinciden.' 2
    unset second
  fi
  backup_passphrase="$first"; unset first
}
backup() (
  (( $# <= 1 )) || fail 'Uso: ./gotchu backup [archivo]' 2
  require_managed_state; require_private_env; check_docker; check_node
  command -v tar >/dev/null 2>&1 || fail 'Se requiere tar para empaquetar la copia local.' 2
  local running stage output_dir backup_path temporary_dir='' temporary_file='' source name
  running="$("${compose[@]}" ps --status running --services 2>/dev/null)" || fail 'No se pudo consultar el estado de Postgres.'
  [[ $'\n'"$running"$'\n' == *$'\npostgres\n'* ]] || fail 'Inicia Gotchu antes de crear la copia: Postgres debe estar ejecutándose.' 2
  read_backup_passphrase confirm
  umask 077
  stage="$(mktemp -d "$state_dir/.backup.XXXXXX")" || fail 'No se pudo preparar el área privada de la copia.'
  cleanup_backup() { unset backup_passphrase; rm -rf -- "$stage" ${temporary_dir:+"$temporary_dir"}; }
  trap cleanup_backup EXIT
  if [[ -n "${1:-}" ]]; then
    backup_path="$1"
    [[ "$backup_path" == /* ]] || backup_path="$PWD/$backup_path"
    output_dir="$(dirname -- "$backup_path")"
    mkdir -p -- "$output_dir"
  else
    output_dir="${state_dir}.backups"
    if [[ -e "$output_dir" || -L "$output_dir" ]]; then
      [[ -d "$output_dir" && ! -L "$output_dir" ]] || fail 'El directorio de copias junto al estado debe ser un directorio real.' 2
    else
      mkdir -m 700 -- "$output_dir"
    fi
    chmod 700 "$output_dir"
    backup_path="$output_dir/gotchu-$(date -u +%Y%m%d-%H%M%S).backup"
  fi
  [[ ! -e "$backup_path" && ! -L "$backup_path" ]] || fail 'El archivo de destino ya existe; elige otro nombre para no reemplazar una copia anterior.' 2
  chmod 700 "$stage"
  temporary_dir="$(mktemp -d "$output_dir/.gotchu-backup.XXXXXX")" || fail 'No se pudo preparar la salida cifrada.'
  chmod 700 "$temporary_dir"
  temporary_file="$temporary_dir/backup"

  mkdir -m 700 "$stage/state"
  "${compose[@]}" exec -T postgres sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom --compress=6' >"$stage/database.dump" || fail 'No se pudo crear el snapshot consistente de PostgreSQL.'
  for name in .env .gotchu-state scanner.secret scanner.crt scanner.key; do
    source="$state_dir/$name"
    [[ -f "$source" && ! -L "$source" ]] || fail "Falta el archivo local necesario para restaurar: $name."
    install -m 600 -- "$source" "$stage/state/$name"
  done
  if [[ -e "$state_dir/scanner.tls-fingerprint" ]]; then
    [[ -f "$state_dir/scanner.tls-fingerprint" && ! -L "$state_dir/scanner.tls-fingerprint" ]] || fail 'La identidad TLS del scanner no es un archivo regular.'
    install -m 600 -- "$state_dir/scanner.tls-fingerprint" "$stage/state/scanner.tls-fingerprint"
  fi
  if [[ -e "$state_dir/github" ]]; then
    [[ -d "$state_dir/github" && ! -L "$state_dir/github" ]] || fail 'El directorio privado de GitHub no es válido.'
    mkdir -m 700 "$stage/state/github"
    if [[ -e "$state_dir/github/reader-app.json" ]]; then
      [[ -f "$state_dir/github/reader-app.json" && ! -L "$state_dir/github/reader-app.json" ]] || fail 'Las credenciales de GitHub deben ser un archivo regular.'
      install -m 600 -- "$state_dir/github/reader-app.json" "$stage/state/github/reader-app.json"
    fi
  fi
  local -a archive_paths=(database.dump state/ state/.env state/.gotchu-state state/scanner.secret state/scanner.crt state/scanner.key)
  [[ -f "$stage/state/scanner.tls-fingerprint" ]] && archive_paths+=(state/scanner.tls-fingerprint)
  [[ -d "$stage/state/github" ]] && archive_paths+=(state/github/)
  [[ -f "$stage/state/github/reader-app.json" ]] && archive_paths+=(state/github/reader-app.json)
  tar --no-recursion -czf "$stage/payload.tar.gz" -C "$stage" "${archive_paths[@]}" || fail 'No se pudo empaquetar el contenido de la copia.'
  node "$root/scripts/gotchu-backup-archive.mjs" validate "$stage/payload.tar.gz" || fail 'El contenido preparado no coincide con el formato de copia permitido.'
  printf '%s\n' "$backup_passphrase" | node "$root/scripts/gotchu-backup-crypto.mjs" encrypt "$stage/payload.tar.gz" "$temporary_file" || fail 'No se pudo cifrar la copia local.'
  chmod 600 "$temporary_file"
  mv -- "$temporary_file" "$backup_path"
  printf 'Copia cifrada creada: %s\n' "$backup_path"
)
restore() (
  (( $# == 1 )) || fail 'Uso: ./gotchu restore <archivo>' 2
  local backup_path="$1" stage payload extracted running postgres_started=false restore_env name
  require_managed_state; require_private_env; check_docker; check_node
  command -v tar >/dev/null 2>&1 || fail 'Se requiere tar para restaurar la copia local.' 2
  [[ -f "$backup_path" && ! -L "$backup_path" ]] || fail 'El archivo de respaldo debe ser un archivo regular.' 2
  for name in scanner.secret scanner.crt scanner.key scanner.tls-fingerprint; do
    [[ ! -L "$state_dir/$name" ]] || fail "No se restauró: el destino local $name es un enlace simbólico."
  done
  [[ ! -e "$state_dir/github" || ( -d "$state_dir/github" && ! -L "$state_dir/github" ) ]] || fail 'No se restauró: el directorio local de GitHub no es válido.'
  [[ ! -L "$state_dir/github/reader-app.json" ]] || fail 'No se restauró: las credenciales locales de GitHub son un enlace simbólico.'
  running="$("${compose[@]}" ps --status running --services 2>/dev/null)" || fail 'No se pudo consultar el estado de la instalación.'
  [[ -z "$running" ]] || fail 'Detén todos los servicios con ./gotchu down antes de restaurar.' 2
  for service in web coordinator scanner; do app_running "$service" && fail "Detén también el proceso ${service} con ./gotchu down antes de restaurar." 2; done
  umask 077
  stage="$(mktemp -d "$state_dir/.restore.XXXXXX")" || fail 'No se pudo preparar el área privada de restauración.'
  chmod 700 "$stage"
  payload="$stage/payload.tar.gz"; extracted="$stage/extracted"; restore_env="$stage/restored.env"
  cleanup_restore() {
    unset backup_passphrase
    rm -rf -- "$stage"
    if [[ "$postgres_started" == true ]]; then "${compose[@]}" stop postgres >/dev/null 2>&1 || true; fi
  }
  trap cleanup_restore EXIT
  read_backup_passphrase
  printf '%s\n' "$backup_passphrase" | node "$root/scripts/gotchu-backup-crypto.mjs" decrypt "$backup_path" "$payload" || fail 'No se pudo autenticar el respaldo; no se modificó la base de datos.' 2
  node "$root/scripts/gotchu-backup-archive.mjs" extract "$payload" "$extracted" || fail 'El contenido cifrado del respaldo no es válido.' 2
  [[ "$(cat "$extracted/state/.gotchu-state")" == 'gotchu-self-host-state-v1' ]] || fail 'El respaldo no contiene un estado Gotchu compatible.' 2
  node "$root/scripts/gotchu-restore-env.mjs" "$extracted/state/.env" "$env_file" "$restore_env" || fail 'No se modificó la base: las credenciales o la identidad de esta instalación no coinciden con el respaldo.' 2
  printf 'Esto reemplazará los datos Postgres de %s y mantendrá los servicios detenidos hasta que ejecutes ./gotchu up. Escribe RESTORE para continuar: ' "$project" >&2
  local answer; IFS= read -r answer || fail 'No se pudo leer la confirmación.' 2
  [[ "$answer" == RESTORE ]] || fail 'Restauración cancelada.' 2

  "${compose[@]}" up -d postgres || fail 'No se pudo iniciar Postgres para la restauración.'
  postgres_started=true
  local ready=false
  for _ in $(seq 1 90); do
    if "${compose[@]}" exec -T postgres pg_isready -h 127.0.0.1 -U "$(env_value POSTGRES_USER)" -d "$(env_value POSTGRES_DB)" >/dev/null 2>&1; then ready=true; break; fi
    sleep 1
  done
  [[ "$ready" == true ]] || fail 'Postgres no alcanzó estado saludable; los servicios web y coordinator siguen detenidos.'
  printf '%s\n' "UPDATE gotchu.platform_state SET recovery_epoch=recovery_epoch+1,writes_frozen=true,reconciliation_reference=NULL,updated_at=clock_timestamp() WHERE singleton;" \
    | "${compose[@]}" exec -T postgres sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" psql -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atq' \
    || fail 'No se pudo congelar la autorización actual; no se iniciará ningún servicio de aplicación.'
  "${compose[@]}" exec -T postgres sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" pg_restore --exit-on-error --clean --if-exists --single-transaction -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' \
    <"$extracted/database.dump" || fail 'Postgres no pudo restaurar el snapshot; los servicios de aplicación siguen detenidos.'
  printf '%s\n' "UPDATE gotchu.platform_state SET recovery_epoch=recovery_epoch+1,writes_frozen=true,reconciliation_reference=NULL,updated_at=clock_timestamp() WHERE singleton;" \
    | "${compose[@]}" exec -T postgres sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" psql -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atq' \
    || fail 'La base se restauró, pero no se pudo incrementar el epoch de recuperación; deja la instalación detenida y revisa Postgres.'
  mv -- "$restore_env" "$env_file"; chmod 600 "$env_file"
  for name in scanner.secret scanner.crt scanner.key; do install -m 600 -- "$extracted/state/$name" "$state_dir/$name"; done
  if [[ -f "$extracted/state/scanner.tls-fingerprint" ]]; then install -m 600 -- "$extracted/state/scanner.tls-fingerprint" "$state_dir/scanner.tls-fingerprint"; else rm -f -- "$state_dir/scanner.tls-fingerprint"; fi
  mkdir -p "$state_dir/github"; chmod 700 "$state_dir/github"
  if [[ -f "$extracted/state/github/reader-app.json" ]]; then install -m 600 -- "$extracted/state/github/reader-app.json" "$state_dir/github/reader-app.json"; else rm -f -- "$state_dir/github/reader-app.json"; fi
  "${compose[@]}" stop postgres >/dev/null || fail 'Datos restaurados; Postgres no se detuvo al terminar. No inicies la aplicación hasta confirmar el estado.'
  postgres_started=false
  printf '%s\n' 'Restauración completada. El epoch de recuperación aumentó, las escrituras de proveedor siguen congeladas y todos los servicios están detenidos. Ejecuta ./gotchu up cuando estés listo.'
  trap - EXIT
  cleanup_restore
)
down() {
  check_docker; [[ -f "$env_file" ]] || { printf '%s\n' 'Gotchu ya está detenido.'; return; }
  require_managed_state; require_private_env
  stop_app web; stop_app coordinator; stop_app scanner
  "${compose[@]}" --profile web --profile coordinator down; printf '%s\n' 'Servicios detenidos; se conservaron datos y secretos.'
}
reset() {
  [[ -f "$env_file" ]] || fail 'No se encontró el estado local de Gotchu.' 2
  require_managed_state; require_private_env
  printf 'Esto elimina workspaces, informes, fuentes y credenciales de %s. Escribe RESET para continuar: ' "$project"
  local answer; read -r answer; [[ "$answer" == RESET ]] || fail 'Reinicio cancelado.' 2
  check_docker; stop_app web; stop_app coordinator; stop_app scanner
  "${compose[@]}" --profile web --profile coordinator down --volumes --remove-orphans; rm -rf -- "$state_dir"; printf 'Datos locales eliminados. Las copias cifradas del directorio %s se conservaron.\n' "${state_dir}.backups"
}
doctor() {
  local failed=0
  if command -v docker >/dev/null 2>&1; then printf 'Docker: '; docker info >/dev/null 2>&1 && printf '%s\n' 'disponible' || { printf '%s\n' 'no iniciado o sin permisos'; failed=1; }; else printf '%s\n' 'Docker: no instalado'; failed=1; fi
  if command -v docker >/dev/null 2>&1 && docker compose version --short >/dev/null 2>&1; then printf '%s\n' 'Compose: v2 disponible'; else printf '%s\n' 'Compose: instala Docker Compose v2'; failed=1; fi
  command -v node >/dev/null && node -e 'process.exit(Number(process.versions.node.split(".")[0])===24?0:1)' && printf '%s\n' 'Node.js: versión 24 disponible' || { printf '%s\n' 'Node.js: se requiere versión 24'; failed=1; }
  command -v pnpm >/dev/null && [[ "$(pnpm --version)" == 11.* ]] && printf '%s\n' 'pnpm: versión 11 disponible' || { printf '%s\n' 'pnpm: se requiere versión 11'; failed=1; }
  command -v openssl >/dev/null && printf '%s\n' 'OpenSSL: disponible' || { printf '%s\n' 'OpenSSL: se requiere para generar secretos locales'; failed=1; }
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local docker_root free_kib
    docker_root="$(docker info --format '{{.DockerRootDir}}')"; free_kib="$(df -Pk "$docker_root" | awk 'NR==2 {print $4}')"
    if [[ "$free_kib" =~ ^[0-9]+$ ]] && (( free_kib < 5242880 )); then printf '%s\n' 'Docker storage: menos de 5 GiB libres; revisa docker system df y elimina sólo datos que reconozcas como tuyos y que estén sin uso antes de ./gotchu up.'; failed=1; elif [[ "$free_kib" =~ ^[0-9]+$ ]]; then printf '%s\n' 'Docker storage: al menos 5 GiB libres'; fi
  fi
  if [[ -e /dev/kvm ]] && command -v bwrap >/dev/null && [[ -n "${XDG_RUNTIME_DIR:-}" ]] && command -v systemctl >/dev/null && systemctl --user is-system-running >/dev/null 2>&1; then printf '%s\n' 'VM validator: requisitos detectados; las imágenes aún requieren preparación manual.'; else printf '%s\n' 'VM validator: requiere Linux, /dev/kvm, bwrap y sesión systemd de usuario.'; fi
  [[ -d "$state_dir" ]] && df -h "$state_dir" || true; return "$failed"
}
github_setup() {
  ensure_state
  local public_url="${GOTCHU_PUBLIC_URL:-http://localhost:${GOTCHU_WEB_PORT:-3000}}"
  if [[ -f "$env_file" ]]; then public_url="$(sed -n 's/^PUBLIC_APP_URL=//p' "$env_file" | head -n1)"; fi
  printf 'GitHub App de sólo lectura: concede Contents: Read-only y Metadata: Read-only. Configura el callback de autorización que usa Conectar GitHub como %s/api/customer/github/callback.\n' "$public_url"
  printf 'Copia el JSON de credenciales en %s/github/reader-app.json y limita el archivo a modo 0600.\n' "$state_dir"
  printf 'En %s configura GOTCHU_GITHUB_READER_APP_FILE=%s/github/reader-app.json y GOTCHU_GITHUB_APP_SLUG=<slug>.\n' "$env_file" "$state_dir"
  printf 'Para Sign in with GitHub, agrega %s/api/auth/callback/github a los callback URLs de autorización de la GitHub App.\n' "$public_url"
  printf 'En %s configura AUTH_GITHUB_ID=<client-id> y AUTH_GITHUB_SECRET=<client-secret>; el botón aparece sólo cuando ambos están configurados.\n' "$env_file"
  printf '%s\n' 'Si prefieres separar el inicio de sesión de la instalación, crea una OAuth App, registra ese callback en ella y usa su client ID y client secret en AUTH_GITHUB_ID/AUTH_GITHUB_SECRET.'
  printf '%s\n' 'Vuelve a ejecutar ./gotchu up tras cambiar credenciales o .env. La App sólo lee los repositorios autorizados en la instalación; Gotchu no escribe en GitHub.'
}
google_setup() {
  ensure_state
  local public_url="${GOTCHU_PUBLIC_URL:-http://localhost:${GOTCHU_WEB_PORT:-3000}}"
  if [[ -f "$env_file" ]]; then public_url="$(sed -n 's/^PUBLIC_APP_URL=//p' "$env_file" | head -n1)"; fi
  printf '%s\n' 'En Google Cloud Console, abre APIs y servicios > Credenciales y crea un ID de cliente OAuth para una aplicación web.'
  printf 'Orígenes de JavaScript autorizados (exacto): %s\n' "$public_url"
  printf 'URI de redirección autorizados (exacto): %s/api/auth/callback/google\n' "$public_url"
  printf 'En %s configura AUTH_GOOGLE_ID=<client-id> y AUTH_GOOGLE_SECRET=<client-secret>; el botón aparece sólo cuando ambos están configurados.\n' "$env_file"
  printf '%s\n' 'El proveedor solicita openid, email y profile, y sólo admite correos que Google marca como verificados. Agrega los usuarios permitidos en la pantalla de consentimiento si la aplicación sigue en modo de prueba.'
  printf '%s\n' 'Vuelve a ejecutar ./gotchu up para aplicar las credenciales. Nunca copies el client secret a páginas ni a registros.'
}

case "$command_name" in
  up) up ;;
  backup) backup "$@" ;;
  restore) restore "$@" ;;
  status) status ;;
  logs) logs "${1:-}" ;;
  down) down ;;
  reset) reset ;;
  doctor) doctor ;;
  setup-link) setup_link ;;
  upgrade)
    [[ -f "$env_file" ]] || fail 'Ejecuta ./gotchu up antes de actualizar el entorno.' 2
    require_managed_state; require_private_env
    printf '%s\n' 'Se reconstruirá desde este checkout, aplicará migraciones y reiniciará los servicios sin cambiar tus volúmenes.'
    up true
    ;;
  github) [[ "${1:-}" == setup ]] || fail 'Uso: ./gotchu github setup' 2; github_setup ;;
  google) [[ "${1:-}" == setup ]] || fail 'Uso: ./gotchu google setup' 2; google_setup ;;
  *) fail 'Uso: ./gotchu up|status|logs [service]|down|reset|backup [archivo]|restore <archivo>|doctor|setup-link|upgrade|github setup|google setup' 2 ;;
esac
