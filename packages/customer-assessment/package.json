{
  "name": "@gotchu/customer-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./supply-chain": {
      "types": "./dist/licenses.d.ts",
      "import": "./dist/licenses.js"
    },
    "./sbom": {
      "types": "./dist/sbom.d.ts",
      "import": "./dist/sbom.js"
    }
  },
  "files": [
    "dist",
    "profiles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:live": "node ../../scripts/update-trivy-db.mjs && vitest run test/scanners.live.test.ts test/supply-chain.live.test.ts test/npm-artifacts.live.test.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.2",
    "@gotchu/contracts": "workspace:*",
    "typescript": "~5.9.3",
    "js-yaml": "4.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1"
  }
}
