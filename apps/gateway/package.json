{
  "name": "@gotchu/gateway", "version": "0.1.0", "private": true, "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./migrate": { "types": "./dist/migrate.d.ts", "import": "./dist/migrate.js" }
  },
  "files": ["dist", "migrations", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:postgres": "node test/run-postgres.mjs",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@gotchu/agent": "workspace:*", "@gotchu/backend": "workspace:*",
    "@gotchu/contracts": "workspace:*", "@gotchu/database": "workspace:*",
    "jose": "^6.2.13", "pg": "^8.16.3", "zod": "^4.0.0"
  },
  "devDependencies": { "@gotchu/worker": "workspace:*", "@types/pg": "^8.15.5" }
}
