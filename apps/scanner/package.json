{
  "name": "@gotchu/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:production": "pnpm run build && GOTCHU_SCANNER_PRODUCTION_SMOKE=1 pnpm exec vitest run test/production-smoke.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@gotchu/contracts": "workspace:*",
    "@gotchu/customer-assessment": "workspace:*",
    "zod": "^4.0.0"
  }
}
