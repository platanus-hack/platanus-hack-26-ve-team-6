{
  "name": "gotchu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "build:packages": "pnpm --filter './packages/**' -r --sort --if-present build",
    "typecheck": "pnpm -r --sort --if-present typecheck && tsc -p test/tsconfig.json",
    "test": "pnpm -r --sort --if-present test",
    "test:integration": "node test/run-stack.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "dev:start": "node scripts/development.mjs start",
    "dev:stop": "node scripts/development.mjs stop",
    "dev:prepare": "node scripts/development.mjs prepare"
  },
  "devDependencies": {
    "@gotchu/assessment": "workspace:*",
    "@gotchu/demo-target": "workspace:*",
    "@auth/core": "0.41.3",
    "@gotchu/agent": "workspace:*",
    "@gotchu/backend": "workspace:*",
    "@gotchu/coordinator": "workspace:*",
    "@gotchu/database": "workspace:*",
    "@gotchu/gateway": "workspace:*",
    "@gotchu/sdk": "workspace:*",
    "@gotchu/worker": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "bullmq": "6.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.0.0",
    "@gotchu/customer-assessment": "workspace:*",
    "@gotchu/scanner": "workspace:*",
    "@gotchu/monitoring": "workspace:*",
    "@gotchu/scenarios": "workspace:*",
    "@gotchu/runner": "workspace:*",
    "@gotchu/contracts": "workspace:*",
    "@gotchu/triage": "workspace:*",
    "@gotchu/git-adapters": "workspace:*"
  }
}
