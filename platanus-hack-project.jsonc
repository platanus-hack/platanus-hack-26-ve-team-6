{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Gotchu",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Encuentra riesgos de seguridad en tu app y recibe ayuda para corregirlos.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Gotchu te ayuda a encontrar riesgos de seguridad en tu aplicación y entender qué hacer con ellos. Revisa código, dependencias y configuración web conectando GitHub, subiendo una carpeta o indicando una URL HTTPS autorizada. La revisión web funciona sin compartir tu código. Cada informe muestra los hallazgos, su gravedad, las pruebas y lo que quedó sin revisar. Puedes llevar cada hallazgo a tu asistente de código o configurar la IA de Gotchu para investigar y preparar correcciones privadas.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://gotchu.kevinbravo.com"
}
