{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Gotchu",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Encuentra los riesgos de tu app y llega al próximo deploy sabiendo qué corregir.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Tu app ya funciona. Descubre qué se te escapó. Con Gotchu puedes revisar tu web pegando su URL HTTPS, subir una carpeta de código o conectar GitHub. Encuentra riesgos en el código, las dependencias y la configuración web, con pruebas para entender cada hallazgo y decidir qué corregir. Lleva el contexto a tu asistente de código o configura la IA de Gotchu para investigar y preparar correcciones privadas. Empieza por tu propia web, incluso sin compartir su código.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://gotchu.kevinbravo.com"
}
